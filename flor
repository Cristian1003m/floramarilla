<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Feliz Día de las Flores Amarillas</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg1:#fff8e1; --bg2:#f5e6bb; --ink:#2b2013; --gold:#e8a814; --teal:#1f8a7a; --dark:0;
    --glow:none;
    color-scheme: light dark;
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top,0px);
    padding-bottom: env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){ --bg1:#241a09; --bg2:#0d0a04; --ink:#f7ebc9; --dark:1; --glow:0 0 18px rgba(255,196,60,.35); }
  }
  :root[data-theme="dark"]{ --bg1:#241a09; --bg2:#0d0a04; --ink:#f7ebc9; --dark:1; --glow:0 0 18px rgba(255,196,60,.35); }
  *{box-sizing:border-box}
  html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
  html,body{margin:0;background:var(--bg2);color:var(--ink)}
  body{
    min-height:100%;
    font-family:'Cinzel',Georgia,serif;
    background:radial-gradient(120% 90% at 72% 38%, var(--bg1) 0%, var(--bg2) 75%) fixed;
    display:flex;align-items:center;justify-content:center;
    overflow-x:hidden;
  }
  canvas#c{position:fixed;inset:0;width:100%;height:100%;z-index:0;display:block;pointer-events:none}
  .wrap{
    position:relative;z-index:1;
    width:100%;max-width:1120px;padding:24px;
    display:grid;grid-template-columns:1fr 1.1fr;gap:16px;align-items:center;
  }
  .text{
    padding:0 8px;display:grid;grid-template-columns:minmax(0,1fr) clamp(150px,17vw,200px);
    column-gap:22px;align-items:start;
  }
  .text h1{grid-column:1/-1}
  .text .msg{grid-column:1;grid-row:2}
  .text .sign{grid-column:1;grid-row:3;justify-self:start}
  .polaroid{
    grid-column:2;grid-row:2/4;margin:6px 0 0;position:relative;
    background:#fffdf6;padding:9px 9px 32px;border-radius:3px;
    box-shadow:0 12px 30px rgba(60,35,0,.3),0 2px 6px rgba(60,35,0,.2);
    transform:rotate(3deg) scale(.88);opacity:0;
    animation:pop 1.1s 1.2s cubic-bezier(.2,.9,.3,1.2) forwards;
  }
  @keyframes pop{to{opacity:1;transform:rotate(3deg) scale(1)}}
  .polaroid .ph{overflow:hidden;border-radius:2px;background:#eee}
  .polaroid img{display:block;width:100%;aspect-ratio:312/266;object-fit:cover;transition:transform .8s ease}
  .polaroid:hover img{transform:scale(1.06)}
  .polaroid::before{
    content:'';position:absolute;top:-11px;left:50%;width:66px;height:20px;
    transform:translateX(-50%) rotate(-4deg);background:rgba(255,212,80,.78);
    box-shadow:0 1px 3px rgba(0,0,0,.18);
  }
  .polaroid::after{content:'🌻';position:absolute;right:9px;bottom:5px;font-size:18px}
  h1{
    font-size:clamp(18px,2.4vw,26px);font-weight:700;letter-spacing:.02em;
    margin:0 0 22px;line-height:1.4;text-shadow:var(--glow);
    opacity:0;transform:translateY(-8px);
    animation:title 1.2s .3s cubic-bezier(.2,.7,.2,1) forwards;
  }
  @keyframes title{to{opacity:1;transform:none}}
  h1 .em{display:inline-block;animation:spin 14s linear infinite}
  h1 .em:last-child{animation-direction:reverse}
  @keyframes spin{to{transform:rotate(360deg)}}
  .msg{
    font-size:clamp(15px,1.9vw,20px);line-height:1.75;font-weight:500;
    min-height:9em;margin:0;text-shadow:var(--glow);
  }
  .msg .l{display:block}
  .msg .l.gap{margin-bottom:.55em}
  .msg .w{
    display:inline-block;opacity:0;filter:blur(7px);transform:translateY(10px);
    transition:opacity .9s ease,filter .9s ease,transform .9s cubic-bezier(.2,.7,.2,1);
  }
  .msg .l.on .w{opacity:1;filter:none;transform:none}
  .sign{
    position:relative;display:inline-block;
    font-family:'Caveat',cursive;font-size:clamp(21px,2.7vw,30px);
    margin-top:26px;font-style:italic;font-weight:600;
    opacity:0;transform:translateY(8px);
    transition:opacity 1.2s ease,transform 1.2s ease;
    text-shadow:var(--glow);
  }
  .sign.on{opacity:1;transform:none}
  .sign svg{position:absolute;left:0;bottom:-8px;width:100%;height:12px;overflow:visible}
  .sign path{
    fill:none;stroke:var(--gold);stroke-width:2.2;stroke-linecap:round;
    stroke-dasharray:1;stroke-dashoffset:1;
    transition:stroke-dashoffset 1.6s .5s cubic-bezier(.4,0,.2,1);
  }
  .sign.on path{stroke-dashoffset:0}
  .stage{position:relative;width:100%;aspect-ratio:1/1.1;max-height:calc(100vh - 48px)}
  button.replay{
    position:fixed;z-index:5;right:max(14px,env(safe-area-inset-right,0px));
    bottom:calc(14px + env(safe-area-inset-bottom,0px));
    background:var(--gold);color:#2a2118;border:0;border-radius:999px;
    padding:10px 16px;font:600 13px 'Cinzel',serif;cursor:pointer;
    box-shadow:0 4px 18px rgba(232,168,20,.45);
  }
  button.replay:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
  @media (max-width:860px){
    .wrap{grid-template-columns:1fr;padding:16px;padding-bottom:64px;gap:8px}
    .text{grid-template-columns:1fr}
    .polaroid{grid-column:1;grid-row:2;width:min(158px,46%);justify-self:center;margin:6px 0 22px;padding:7px 7px 24px}
    .polaroid::after{font-size:14px;bottom:3px}
    h1{margin-bottom:14px}
    .text .msg{grid-row:3}
    .text .sign{grid-row:4}
    .msg{min-height:0}
    .stage{aspect-ratio:1/1.02}
  }
  @media (prefers-reduced-motion: reduce){
    h1{animation:none;opacity:1;transform:none}
    h1 .em{animation:none}
    .polaroid{animation:none;opacity:1;transform:rotate(3deg)}
    .msg .w,.sign,.sign path{transition:none}
  }
</style>
</head>
<body>
<canvas id="c" aria-hidden="true"></canvas>
<main class="wrap">
  <section class="text">
    <h1><span class="em">🌻</span> Feliz Día de las Flores Amarillas <span class="em">🌻</span></h1>
    <p class="msg" id="msg" aria-live="polite"></p>
    <figure class="polaroid"><div class="ph"><img alt="Nuestra foto" src="data:image/jpeg;base64,"></div></figure>
    <div class="sign" id="sign">Eres el sol que hace florecer cada uno de mis días. ✦
      <svg viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 8 Q 40 1 80 7 T 160 6 T 240 7 T 298 4"/></svg>
    </div>
  </section>
  <section class="stage" id="stage" role="img" aria-label="Un árbol en forma de corazón hecho de girasoles"></section>
</main>
<button class="replay" id="replay">Ver de nuevo</button>

<script>
(function(){
'use strict';
var TAU=Math.PI*2;
var LINES=[
  "Cada girasol que ves",
  "aquí es un latido de mi corazón.",
  "Así como el sol ilumina los campos,",
  "tú iluminas mi vida.",
  "Que estas flores te recuerden",
  "lo especial que eres para mí.",
  "— ¡Te amo!"
];
var msg=document.getElementById('msg'), sign=document.getElementById('sign'), stage=document.getElementById('stage');
var canvas=document.getElementById('c'), ctx=canvas.getContext('2d');
var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function rnd(a,b){return a+Math.random()*(b-a)}
function lerp(a,b,t){return a+(b-a)*t}
function clamp(v,a,b){return v<a?a:(v>b?b:v)}
function easeOutCubic(x){return 1-Math.pow(1-x,3)}
function easeOutBack(x){var c1=1.9,c3=c1+1;return 1+c3*Math.pow(x-1,3)+c1*Math.pow(x-1,2)}
function gauss(p,c,w){var d=p-c;return Math.exp(-(d*d)/(2*w*w))}

/* ---------- Sprites (se dibujan una vez, luego se estampan) ---------- */
var S=160, PR=S*.44;
var PAL=[
  {b0:'#c97a05',b1:'#eaa10e',f0:'#eeaa10',f1:'#ffd93d',ring:'#9b6321'},
  {b0:'#d68c07',b1:'#f2b116',f0:'#f5b91b',f1:'#ffe155',ring:'#8f5a1c'},
  {b0:'#e08a0a',b1:'#f6a913',f0:'#f9bf1f',f1:'#ffd23a',ring:'#a2661b'}
];
var NS=[13,14,15,16,17,14,16,15,18];
var sprites=[],leafSprites=[],glow;

function makeSprite(v){
  var c=document.createElement('canvas');c.width=c.height=S;
  var g=c.getContext('2d');g.translate(S/2,S/2);
  var P=PAL[v%3],n=NS[v],disc=PR*(.34+.02*(v%3)),r0=disc*.55;
  function ring(count,off,len,wid,c0,c1,blur){
    g.shadowColor='rgba(70,35,0,.5)';g.shadowBlur=blur;
    for(var i=0;i<count;i++){
      var a=i/count*TAU+off+(Math.random()-.5)*.1;
      var L=(PR-r0)*len*rnd(.94,1.05),w=PR*.15*wid;
      g.save();g.rotate(a);
      var gr=g.createLinearGradient(r0,0,r0+L,0);gr.addColorStop(0,c0);gr.addColorStop(1,c1);
      g.beginPath();g.moveTo(r0,0);
      g.bezierCurveTo(r0+L*.25,-w,r0+L*.7,-w*1.05,r0+L,0);
      g.bezierCurveTo(r0+L*.7,w*1.05,r0+L*.25,w,r0,0);
      g.closePath();g.fillStyle=gr;g.fill();
      g.shadowBlur=0;
      g.lineWidth=.8;g.strokeStyle='rgba(150,80,0,.35)';g.stroke();
      g.beginPath();g.moveTo(r0+L*.12,0);g.lineTo(r0+L*.78,0);
      g.strokeStyle='rgba(160,90,0,.3)';g.lineWidth=.9;g.stroke();
      g.shadowBlur=blur;
      g.restore();
    }
    g.shadowBlur=0;
  }
  ring(n,0,.98,1.08,P.b0,P.b1,5);
  ring(n,Math.PI/n,.86,1,P.f0,P.f1,3);
  var sh=g.createRadialGradient(0,0,disc*.9,0,0,disc*1.55);
  sh.addColorStop(0,'rgba(90,45,0,.55)');sh.addColorStop(1,'rgba(90,45,0,0)');
  g.fillStyle=sh;g.beginPath();g.arc(0,0,disc*1.55,0,TAU);g.fill();
  var dg=g.createRadialGradient(-disc*.25,-disc*.25,disc*.1,0,0,disc);
  dg.addColorStop(0,'#8a5a20');dg.addColorStop(.55,'#5c3510');dg.addColorStop(1,'#33190a');
  g.beginPath();g.arc(0,0,disc,0,TAU);g.fillStyle=dg;g.fill();
  g.lineWidth=disc*.14;g.strokeStyle=P.ring;g.stroke();
  for(var i=1;i<90;i++){
    var rr=disc*.86*Math.sqrt(i/90),aa=i*2.39996;
    g.beginPath();g.arc(Math.cos(aa)*rr,Math.sin(aa)*rr,disc*.045+(i/90)*disc*.02,0,TAU);
    g.fillStyle=(i%2)?'rgba(20,9,0,.6)':'rgba(190,130,50,.5)';g.fill();
  }
  return c;
}
function makeLeaf(c0,c1){
  var c=document.createElement('canvas');c.width=100;c.height=50;
  var g=c.getContext('2d');g.translate(4,25);
  var gr=g.createLinearGradient(0,0,92,0);gr.addColorStop(0,c0);gr.addColorStop(1,c1);
  g.beginPath();g.moveTo(0,0);g.bezierCurveTo(20,-24,70,-22,92,0);g.bezierCurveTo(70,22,20,24,0,0);
  g.fillStyle=gr;g.fill();
  g.beginPath();g.moveTo(2,0);g.lineTo(84,0);g.strokeStyle='rgba(0,60,50,.35)';g.lineWidth=1.4;g.stroke();
  return c;
}
function makeGlow(){
  var c=document.createElement('canvas');c.width=c.height=64;
  var g=c.getContext('2d'),gr=g.createRadialGradient(32,32,0,32,32,32);
  gr.addColorStop(0,'rgba(255,240,170,1)');gr.addColorStop(.35,'rgba(255,200,60,.55)');gr.addColorStop(1,'rgba(255,190,40,0)');
  g.fillStyle=gr;g.fillRect(0,0,64,64);return c;
}
function makeAll(){
  for(var v=0;v<9;v++)sprites.push(makeSprite(v));
  leafSprites=[makeLeaf('#157a68','#2fb59b'),makeLeaf('#0f6a58','#23a088')];
  glow=makeGlow();
}

/* ---------- Geometría del árbol (en unidades normalizadas) ---------- */
function inHeart(x,y){var a=x*x+y*y-1;return a*a*a-x*x*y*y*y<0}
var flowers=[],leaves=[],branches=[],grass=[],bbox,gN;

function build(){
  var pts=[],tries=0;
  while(tries<80000&&pts.length<440){
    tries++;
    var x=rnd(-1.2,1.2),yu=rnd(-1.15,1.3);
    if(!inHeart(x*1.05,yu*1.05))continue;
    var r=rnd(.075,.115),ok=true;
    for(var i=0;i<pts.length;i++){
      var dx=pts[i].x-x,dy=pts[i].y+yu,m=(r+pts[i].r)*.7;
      if(dx*dx+dy*dy<m*m){ok=false;break}
    }
    if(ok)pts.push({x:x,y:-yu,r:r});
  }
  var minX=9,maxX=-9,minY=9,maxY=-9;
  pts.forEach(function(p){
    minX=Math.min(minX,p.x-p.r);maxX=Math.max(maxX,p.x+p.r);
    minY=Math.min(minY,p.y-p.r);maxY=Math.max(maxY,p.y+p.r);
  });
  bbox={minX:minX,maxX:maxX,minY:minY,maxY:maxY,cx:(minX+maxX)/2,w:maxX-minX,h:maxY-minY};
  gN=maxY+.55;
  var O={x:0,y:.45},dmax=0;
  pts.forEach(function(p){p.d=Math.hypot(p.x-O.x,p.y-O.y);dmax=Math.max(dmax,p.d)});
  flowers=pts.map(function(p){
    return {bx:p.x,by:p.y,r:p.r,rot:rnd(0,TAU),spin:Math.random()<.5?-1:1,
      delay:p.d/dmax*4000+rnd(0,300),v:(Math.random()*9)|0,
      ox:0,oy:0,vx:0,vy:0,ph:rnd(0,TAU),hov:0,X:0,Y:0};
  });
  flowers.sort(function(a,b){return a.by-b.by});

  leaves=[];tries=0;
  while(leaves.length<120&&tries<20000){
    tries++;
    var lx=rnd(-1.3,1.3),lyu=rnd(-1.2,1.35);
    if(!inHeart(lx*.95,lyu*.95))continue;
    var ly=-lyu,d=Math.hypot(lx-O.x,ly-O.y)/dmax;
    leaves.push({x:lx,y:ly,len:rnd(.14,.22),rot:Math.atan2(ly-.1,lx)+rnd(-.7,.7),c:(Math.random()*2)|0,
      delay:d*4000-350+rnd(0,200),ph:rnd(0,TAU)});
  }
  leaves.sort(function(a,b){return a.y-b.y});

  branches=[];
  var Op={x:0,y:.42},N=11;
  for(var i=0;i<N;i++){
    var ang=-Math.PI*(.08+.84*i/(N-1)),cs=Math.cos(ang),sn=Math.sin(ang),best=null,bs=-9;
    for(var j=0;j<flowers.length;j++){
      var f=flowers[j],pr=(f.bx-Op.x)*cs+(f.by-Op.y)*sn;
      if(pr>bs){bs=pr;best=f}
    }
    var ex=best.bx,ey=best.by,mx=(Op.x+ex)/2,my=(Op.y+ey)/2;
    var dx2=ex-Op.x,dy2=ey-Op.y,ln=Math.hypot(dx2,dy2)||1,sg=(i%2)?1:-1;
    branches.push({p0:Op,c:{x:mx-dy2/ln*ln*.22*sg,y:my+dx2/ln*ln*.22*sg},p2:{x:ex,y:ey},start:1800+i*90});
  }
  grass=[];
  for(var k=0;k<52;k++)grass.push({u:rnd(-1,1),h:rnd(.1,.3),ph:rnd(0,TAU),c:(Math.random()*3)|0});
}

/* ---------- Estado dinámico ---------- */
var W,H,dpr,t0=0,last=0,raf=0,dark=false,lastDarkCheck=0;
var parts=[],ripples=[],bees=[],landed=false,seedSparkT=0,lastSpawn=0;
var px=-999,py=-999,pAt=-99999;
var timers=[];

function resize(){
  dpr=Math.min(window.devicePixelRatio||1,2);
  W=window.innerWidth;H=window.innerHeight;
  canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.imageSmoothingQuality='high';
}

/* ---------- Texto ---------- */
function buildText(){
  timers.forEach(clearTimeout);timers=[];
  msg.innerHTML='';sign.classList.remove('on');
  LINES.forEach(function(txt,i){
    var line=document.createElement('span');
    line.className='l'+((i===1||i===3)?' gap':'');
    var ws=txt.split(' ');
    ws.forEach(function(w,j){
      var sp=document.createElement('span');sp.className='w';sp.textContent=w;
      sp.style.transitionDelay=(j*85)+'ms';
      line.appendChild(sp);
      if(j<ws.length-1)line.appendChild(document.createTextNode(' '));
    });
    msg.appendChild(line);
    timers.push(setTimeout(function(){line.classList.add('on')},reduce?0:1400+i*1000));
  });
  timers.push(setTimeout(function(){sign.classList.add('on')},reduce?0:1400+LINES.length*1000+300));
}

/* ---------- Partículas ---------- */
function addPart(p){parts.push(p);if(parts.length>170)parts.shift()}
function burst(x,y,inTree){
  if(reduce)return;
  for(var i=0;i<16;i++)addPart({type:'petal',x:x,y:y,vx:rnd(-2.6,2.6),vy:rnd(-3.4,-.4),rot:rnd(0,TAU),vr:rnd(-.12,.12),
    size:rnd(4,7),ph:rnd(0,TAU),alpha:1,rest:0,g:rnd(0,22),c:Math.random()<.5?'#f6c21f':'#e9a90c'});
  for(var j=0;j<5;j++)addPart({type:'fl',x:x,y:y,vx:rnd(-2,2),vy:rnd(-3.2,-.8),rot:rnd(0,TAU),vr:rnd(-.06,.06),
    size:rnd(9,14),v:(Math.random()*9)|0,ph:rnd(0,TAU),alpha:1,rest:0,g:rnd(0,22)});
  if(inTree)for(var k=0;k<5;k++)addPart({type:'heart',x:x+rnd(-20,20),y:y,vy:rnd(-1.3,-.7),size:rnd(7,13),
    ph:rnd(0,TAU),alpha:1,c:Math.random()<.5?'#ffb400':'#ff7a59'});
  ripples.push({x:x,y:y,r:4,a:.8,flat:1});
  var s=layout.s;
  for(var m=0;m<flowers.length;m++){
    var f=flowers[m],dx=f.X-x,dy=f.Y-y,d=Math.hypot(dx,dy)||1,R=s*1.3;
    if(d<R){var q=1-d/R;f.vx+=dx/d*q*9;f.vy+=dy/d*q*9}
  }
}
function heartPath(x,y,s){
  ctx.beginPath();
  for(var i=0;i<=24;i++){
    var a=i/24*TAU,hx=16*Math.pow(Math.sin(a),3),hy=-(13*Math.cos(a)-5*Math.cos(2*a)-2*Math.cos(3*a)-Math.cos(4*a));
    if(i===0)ctx.moveTo(x+hx*s/17,y+hy*s/17);else ctx.lineTo(x+hx*s/17,y+hy*s/17);
  }
  ctx.closePath();
}
function glowAt(x,y,r,a){
  ctx.globalAlpha=a;ctx.drawImage(glow,x-r,y-r,r*2,r*2);ctx.globalAlpha=1;
}
function stamp(spr,x,y,size,rot,alpha){
  var sc=size/PR,cs=Math.cos(rot)*sc*dpr,sn=Math.sin(rot)*sc*dpr;
  ctx.globalAlpha=alpha;
  ctx.setTransform(cs,sn,-sn,cs,x*dpr,y*dpr);
  ctx.drawImage(spr,-S/2,-S/2);
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.globalAlpha=1;
}

/* ---------- Layout / bucle ---------- */
var layout={s:100,cxx:0,oy:0,gY:0,hcX:0,hcY:0};
var B0=2600;

function drawBee(b,t,s){
  var bs=Math.max(5,s*.03),face=b.face>=0?1:-1;
  ctx.save();ctx.translate(b.x,b.y);ctx.scale(face,1);ctx.rotate(Math.sin(t/300+b.ph)*.12);
  var fl=Math.sin(t*.06+b.ph)*.5;
  ctx.fillStyle='rgba(255,255,255,.7)';
  ctx.save();ctx.translate(-bs*.1,-bs*.55);ctx.rotate(-.5-fl);ctx.beginPath();ctx.ellipse(0,-bs*.5,bs*.38,bs*.85,0,0,TAU);ctx.fill();ctx.restore();
  ctx.save();ctx.translate(bs*.15,-bs*.55);ctx.rotate(.1+fl);ctx.beginPath();ctx.ellipse(0,-bs*.5,bs*.34,bs*.8,0,0,TAU);ctx.fill();ctx.restore();
  ctx.save();ctx.beginPath();ctx.ellipse(0,0,bs,bs*.68,0,0,TAU);ctx.clip();
  ctx.fillStyle='#ffcf2e';ctx.fillRect(-bs,-bs,bs*2,bs*2);
  ctx.fillStyle='#2a1a05';ctx.fillRect(-bs*.45,-bs,bs*.3,bs*2);ctx.fillRect(bs*.1,-bs,bs*.3,bs*2);
  ctx.restore();
  ctx.fillStyle='#2a1a05';ctx.beginPath();ctx.arc(bs*.95,bs*.05,bs*.4,0,TAU);ctx.fill();
  ctx.restore();
}

function frame(now){
  raf=requestAnimationFrame(frame);
  if(!t0){t0=now-(reduce?20000:0);last=now}
  var t=now-t0;last=now;
  if(now-lastDarkCheck>500){lastDarkCheck=now;dark=getComputedStyle(document.documentElement).getPropertyValue('--dark').trim()==='1'}
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,W,H);
  if(!bbox)return;

  var rc=stage.getBoundingClientRect(),Sw=rc.width,Sh=rc.height;
  if(Sw<10)return;
  var bw=bbox.w,bh=bbox.h+.55;
  var s=Math.min(Sw/(bw*1.04),Sh/(bh*1.04));
  var cxx=rc.left+Sw/2-bbox.cx*s;
  var topY=rc.top+(Sh-bh*s)/2,oy=topY-bbox.minY*s;
  var gY=oy+gN*s;
  var hcX=cxx,hcY=oy+((bbox.minY+bbox.maxY)/2)*s;
  layout.s=s;layout.cxx=cxx;layout.oy=oy;layout.gY=gY;

  var bloom=clamp((t-B0)/5200,0,1);
  var ramp=reduce?0:clamp((t-8200)/1200,0,1);
  var ph=(t%1700)/1700;
  var beatV=ramp*(.035*gauss(ph,.06,.045)+.022*gauss(ph,.26,.05));
  var bsc=1+beatV;
  var wind=Math.sin(t/2300)*.5+Math.sin(t/900)*.2;
  function X(x){return hcX+(cxx+x*s-hcX)*bsc}
  function Y(y){return hcY+(oy+y*s-hcY)*bsc}

  /* halo + rayos */
  var HR=s*1.9,a=(.14+.3*bloom)*(1+beatV*4);
  ctx.globalCompositeOperation=dark?'lighter':'source-over';
  var hg=ctx.createRadialGradient(hcX,hcY,0,hcX,hcY,HR);
  hg.addColorStop(0,'rgba(255,200,60,'+(a*.85)+')');
  hg.addColorStop(.5,'rgba(255,190,50,'+(a*.32)+')');
  hg.addColorStop(1,'rgba(255,190,50,0)');
  ctx.fillStyle=hg;ctx.fillRect(hcX-HR,hcY-HR,HR*2,HR*2);
  var rg=ctx.createRadialGradient(hcX,hcY,HR*.2,hcX,hcY,HR*1.5);
  rg.addColorStop(0,'rgba(255,200,60,'+(.12*bloom)+')');rg.addColorStop(1,'rgba(255,200,60,0)');
  ctx.fillStyle=rg;
  var rot0=reduce?0:t/14000;
  for(var i=0;i<18;i++){
    var a0=rot0+i*TAU/18;
    ctx.beginPath();ctx.moveTo(hcX,hcY);ctx.arc(hcX,hcY,HR*1.5,a0-.05,a0+.05);ctx.closePath();ctx.fill();
  }
  ctx.globalCompositeOperation='source-over';

  /* sombra de suelo y pasto */
  var gk=easeOutCubic(clamp((t-900)/1500,0,1));
  ctx.fillStyle=dark?'rgba(0,0,0,.35)':'rgba(30,110,95,.14)';
  ctx.beginPath();ctx.ellipse(hcX,gY+2,s*1.35*gk,s*.07,0,0,TAU);ctx.fill();
  var half=Math.min(1.6,Sw/(2*s)*.96);
  ctx.lineCap='round';
  var gcol=['#1c8a76','#28a38c','#137060'];
  for(var gi=0;gi<grass.length;gi++){
    var gb=grass[gi],gx=cxx+gb.u*half*s,gh=gb.h*s*gk;
    if(gh<1)continue;
    var sw=(Math.sin(t/900+gb.ph)*.05+wind*.05)*s;
    ctx.strokeStyle=gcol[gb.c];ctx.lineWidth=Math.max(1.6,s*.012);
    ctx.beginPath();ctx.moveTo(gx,gY);ctx.quadraticCurveTo(gx+sw*.4,gY-gh*.6,gx+sw,gY-gh);ctx.stroke();
  }

  /* semilla que cae */
  var gx0=cxx,SEED_T=900,Y0=topY-20;
  if(t<SEED_T){
    var sp=t/SEED_T,sy=Y0+(gY-Y0)*sp*sp;
    ctx.globalCompositeOperation=dark?'lighter':'source-over';
    glowAt(gx0,sy,22,1);
    ctx.globalCompositeOperation='source-over';
    ctx.fillStyle='#ffcf3a';ctx.beginPath();ctx.ellipse(gx0,sy,3.6,6,0,0,TAU);ctx.fill();
    if(!reduce&&now-seedSparkT>24){seedSparkT=now;addPart({type:'spark',x:gx0+rnd(-3,3),y:sy,vx:rnd(-.3,.3),vy:rnd(-.2,.5),size:rnd(4,8),alpha:.9})}
  }else if(!landed){
    landed=true;
    if(!reduce){
      ripples.push({x:gx0,y:gY,r:3,a:.9,flat:.28});
      for(var q=0;q<18;q++)addPart({type:'spark',x:gx0,y:gY-2,vx:rnd(-2,2),vy:rnd(-3.2,-.6),size:rnd(4,9),alpha:1});
    }
  }

  /* tronco */
  var tk=easeOutCubic(clamp((t-900)/1600,0,1));
  if(tk>0.01){
    var n=Math.max(2,Math.round(26*tk)),Lp=[],Rp=[];
    for(var ti=0;ti<=n;ti++){
      var u=ti/n*tk,yy=lerp(gN,.4,u),xx=Math.sin(u*3.2)*.035,ww=.04+.13*Math.exp(-u*6);
      Lp.push([X(xx-ww),Y(yy)]);Rp.push([X(xx+ww),Y(yy)]);
    }
    var tg=ctx.createLinearGradient(X(-.15),0,X(.15),0);
    tg.addColorStop(0,'#127060');tg.addColorStop(.5,'#25a48d');tg.addColorStop(1,'#167a69');
    ctx.fillStyle=tg;ctx.beginPath();ctx.moveTo(Lp[0][0],Lp[0][1]);
    for(var l=1;l<Lp.length;l++)ctx.lineTo(Lp[l][0],Lp[l][1]);
    for(var r=Rp.length-1;r>=0;r--)ctx.lineTo(Rp[r][0],Rp[r][1]);
    ctx.closePath();ctx.fill();
  }
  /* ramas */
  ctx.strokeStyle='#1c8674';
  for(var bi=0;bi<branches.length;bi++){
    var br=branches[bi],bp=easeOutCubic(clamp((t-br.start)/1400,0,1));
    if(bp<=0)continue;
    var seg=Math.max(2,Math.round(22*bp)),prevx=0,prevy=0;
    for(var sI=0;sI<=seg;sI++){
      var uu=sI/seg*bp,m1=(1-uu)*(1-uu),m2=2*(1-uu)*uu,m3=uu*uu;
      var bx=m1*br.p0.x+m2*br.c.x+m3*br.p2.x,by=m1*br.p0.y+m2*br.c.y+m3*br.p2.y;
      var sx=X(bx),sy2=Y(by);
      if(sI>0){ctx.lineWidth=lerp(.05,.012,uu)*s;ctx.beginPath();ctx.moveTo(prevx,prevy);ctx.lineTo(sx,sy2);ctx.stroke()}
      prevx=sx;prevy=sy2;
    }
  }

  /* hojas */
  for(var li=0;li<leaves.length;li++){
    var lf=leaves[li],lt=(t-B0-lf.delay)/700;
    if(lt<=0)continue;
    var lk=easeOutCubic(Math.min(1,lt)),lr=lf.rot+(reduce?0:Math.sin(t/1300+lf.ph)*.06+wind*.03);
    var lsc=(lf.len*s*lk*bsc)/92,lcs=Math.cos(lr)*lsc*dpr,lsn=Math.sin(lr)*lsc*dpr;
    ctx.setTransform(lcs,lsn,-lsn,lcs,X(lf.x)*dpr,Y(lf.y)*dpr);
    ctx.drawImage(leafSprites[lf.c],-4,-25);
  }
  ctx.setTransform(dpr,0,0,dpr,0,0);

  /* flores */
  var pAct=!reduce&&(now-pAt<2500),RR=s*.5;
  for(var fi=0;fi<flowers.length;fi++){
    var f=flowers[fi],flt=(t-B0-f.delay)/850;
    var sway=reduce?0:(Math.sin(t/1600+f.ph)*.006+wind*.004)*s;
    var bx0=X(f.bx)+sway,by0=Y(f.by)+sway*.3;
    var hovT=0;
    if(!reduce){
      if(pAct){
        var ddx=bx0-px,ddy=by0-py,dd=Math.hypot(ddx,ddy)||1;
        if(dd<RR){var qq=1-dd/RR;f.vx+=ddx/dd*qq*qq*2.2;f.vy+=ddy/dd*qq*qq*2.2;hovT=qq}
      }
      f.hov+=(hovT-f.hov)*.15;
      f.vx+=-f.ox*.05;f.vy+=-f.oy*.05;f.vx*=.88;f.vy*=.88;f.ox+=f.vx;f.oy+=f.vy;
    }
    f.X=bx0+f.ox;f.Y=by0+f.oy;
    if(flt<=0)continue;
    var pk=Math.min(1,flt),k=easeOutBack(pk);
    var rot=f.rot+(1-pk)*f.spin*1.6+(reduce?0:t/9000*f.spin);
    var size=f.r*s*k*bsc*(1+f.hov*.22);
    if(size<.5)continue;
    stamp(sprites[f.v],f.X,f.Y,size,rot,1);
  }

  /* partículas */
  if(!reduce&&t>8000&&now-lastSpawn>260&&parts.length<80){
    lastSpawn=now;
    var sf=flowers[(Math.random()*flowers.length)|0];
    if(Math.random()<.85)addPart({type:'petal',x:sf.X,y:sf.Y,vx:rnd(-.3,.3),vy:rnd(0,.3),rot:rnd(0,TAU),vr:rnd(-.05,.05),
      size:rnd(4,7),ph:rnd(0,TAU),alpha:1,rest:0,g:rnd(0,22),c:Math.random()<.5?'#f6c21f':'#e9a90c'});
    else addPart({type:'fl',x:sf.X,y:sf.Y,vx:rnd(-.3,.3),vy:rnd(0,.3),rot:rnd(0,TAU),vr:rnd(-.03,.03),
      size:rnd(9,13),v:(Math.random()*9)|0,ph:rnd(0,TAU),alpha:1,rest:0,g:rnd(0,22)});
  }
  for(var pi=parts.length-1;pi>=0;pi--){
    var p=parts[pi];
    if(p.type==='spark'){
      p.x+=p.vx||0;p.y+=p.vy||0;if(p.vy!==undefined)p.vy+=.03;p.alpha-=.025;
      if(p.alpha<=0){parts.splice(pi,1);continue}
      ctx.globalCompositeOperation=dark?'lighter':'source-over';
      glowAt(p.x,p.y,p.size,p.alpha);
      ctx.globalCompositeOperation='source-over';
    }else if(p.type==='heart'){
      p.y+=p.vy;p.x+=Math.sin(p.ph+t/300)*.4;p.alpha-=.008;
      if(p.alpha<=0){parts.splice(pi,1);continue}
      ctx.globalAlpha=p.alpha;ctx.fillStyle=p.c;heartPath(p.x,p.y,p.size*2);ctx.fill();ctx.globalAlpha=1;
    }else{
      var ground=gY+p.g;
      if(p.y<ground){
        p.vy=Math.min(p.vy+.04,1.5);p.vx*=.985;
        p.x+=p.vx+Math.sin(p.ph+t/350)*.45;p.y+=p.vy;p.rot+=p.vr;
        if(p.y>=ground)p.y=ground;
      }else{p.rest+=16;p.alpha-=16/3000}
      if(p.alpha<=0){parts.splice(pi,1);continue}
      if(p.type==='petal'){
        var flip=Math.abs(Math.cos(p.ph+t/260));
        ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.globalAlpha=p.alpha;
        ctx.fillStyle=p.c;ctx.beginPath();ctx.ellipse(0,0,p.size,p.size*.45*(.3+.7*flip),0,0,TAU);ctx.fill();
        ctx.restore();
      }else{
        stamp(sprites[p.v],p.x,p.y,p.size,p.rot,p.alpha);
      }
    }
  }
  ctx.globalAlpha=1;
  for(var ri=ripples.length-1;ri>=0;ri--){
    var rp=ripples[ri];rp.r+=2.2;rp.a-=.022;
    if(rp.a<=0){ripples.splice(ri,1);continue}
    ctx.strokeStyle='rgba(255,190,50,'+rp.a+')';ctx.lineWidth=2;
    ctx.beginPath();ctx.ellipse(rp.x,rp.y,rp.r,rp.r*rp.flat,0,0,TAU);ctx.stroke();
  }

  /* abejas */
  if(!reduce&&t>6500){
    for(var bI=0;bI<bees.length;bI++){
      var be=bees[bI],tx,ty;
      if(bI===0&&pAct){tx=px+Math.cos(t/260)*14;ty=py+Math.sin(t/210)*10-12}
      else{tx=hcX+Math.cos(t/1000*be.a+be.ph)*s*1.45;ty=hcY+Math.sin(t/1000*be.b+be.ph*2)*s*1.05}
      var ease=(bI===0&&pAct)?.06:.018,ddx2=tx-be.x;
      be.x+=(tx-be.x)*ease;be.y+=(ty-be.y)*ease;
      if(Math.abs(ddx2)>2)be.face=ddx2;
      drawBee(be,t,s);
    }
  }
}

function initBees(){
  bees=[];
  for(var i=0;i<3;i++)bees.push({x:i%2?W+60:-60,y:H*rnd(.2,.6),a:rnd(.55,.9),b:rnd(.7,1.1),ph:rnd(0,TAU),face:1});
}

function start(){
  cancelAnimationFrame(raf);
  t0=0;parts=[];ripples=[];landed=reduce;
  resize();build();initBees();buildText();
  raf=requestAnimationFrame(frame);
}

window.addEventListener('resize',resize);
window.addEventListener('pointermove',function(e){px=e.clientX;py=e.clientY;pAt=performance.now()});
window.addEventListener('pointerdown',function(e){
  if(e.target.closest&&e.target.closest('button'))return;
  px=e.clientX;py=e.clientY;pAt=performance.now();
  var rc=stage.getBoundingClientRect();
  var inTree=e.clientX>=rc.left&&e.clientX<=rc.right&&e.clientY>=rc.top&&e.clientY<=rc.bottom;
  burst(e.clientX,e.clientY,inTree);
});
document.getElementById('replay').addEventListener('click',start);

makeAll();
if(document.fonts&&document.fonts.ready){document.fonts.ready.then(start)}else{start()}
})();
</script>
</body>
</html>
